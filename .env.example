# Database (Prisma + SQLite) - local development only.
# The path is resolved relative to prisma/schema.prisma, so the database file
# is created at prisma/custom.db. Vercel deployments ignore this and use
# Postgres instead (see schema.postgres.prisma).
DATABASE_URL=file:./custom.db

# Production (Vercel): the build script uses prisma/schema.postgres.prisma and
# DATABASE_URL must be a Postgres connection string. It is set automatically
# when you connect a database via Vercel > Storage > Neon, e.g.:
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Gemini LLM (primary provider)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Groq LLM (fallback provider)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Tavily - competitor price research
TAVILY_API_KEY=your-tavily-api-key

# Instagram profile scraping (ScrapeCreators)
INSTAGRAM_SCRAPER_API_KEY=your-scrapecreators-api-key

# Public site URL for creator share links (set after deploying to your own domain)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
